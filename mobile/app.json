{
  "expo": {
    "name": "Chef Jarvis",
    "slug": "chef-jarvis",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "scheme": "chefjarvis",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.njzneverdie.chefjarvis",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "./plugins/with-local-notifications.cjs",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-notifications",
      "./plugins/with-spaces-safe-bundle.cjs",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Chef Jarvis uses the microphone only when you choose voice cooking commands.",
          "speechRecognitionPermission": "Chef Jarvis recognizes your cooking commands. Speech may be processed by Apple."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chef Jarvis reads the cooking video you choose, or the one you just downloaded from Instagram, uploads it for recipe analysis, and deletes it right after.",
          "cameraPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Chef Jarvis reads the cooking video you choose, or the one you just downloaded from Instagram, uploads it for recipe analysis, and deletes it right after.",
          "savePhotosPermission": false,
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "./plugins/with-standalone-run.cjs"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/00137d52-19fb-4b2c-941a-88c559b9187a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "extra": {
      "eas": {
        "projectId": "00137d52-19fb-4b2c-941a-88c559b9187a"
      }
    },
    "owner": "njzneverdies"
  }
}
